# Cloudflare Workers static-asset response headers.
#
# Vite emits every JS/CSS/font chunk under /assets with a content hash in the
# filename, so those responses can be cached forever. Without this file the
# assets layer answers with "public, max-age=0, must-revalidate" and every
# repeat visit revalidates the whole bundle. The matching rules in
# src/worker/index.ts never run for /assets/* because wrangler.json only lists
# "/" and "/index.html" in run_worker_first.

/*
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# public/fonts uses stable filenames (OpenDyslexic-Regular.woff), so no
# immutable here - a replaced font must be able to propagate.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Root images are not content-hashed either. Revalidate daily, and let the
# browser keep serving a stale copy while it refreshes.
/club-logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/club-logo.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/club-logo.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/placeholder.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The service worker and manifest must always revalidate, otherwise a deploy
# can leave clients pinned to an old app shell.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
