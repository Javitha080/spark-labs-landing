# Spark Labs Landing — example environment (placeholder values only, no secrets)
# Copy to .env for local dev: cp .env.example .env
# Worker-side secrets go in .dev.vars locally or `wrangler secret` when deployed.
# Never commit .env, .env.*, or .dev.vars (all gitignored).

# Required — Supabase (public client keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required in production — Cloudflare Turnstile (public widget key).
# Source of truth: wrangler.json `vars` (bridged to CI by scripts/ci/export-build-env.mjs).
# Missing/invalid here, and every Turnstile widget (join/contact/newsletter/logins)
# fails with "Invalid or missing sitekey". Server-side pair key goes in
# .dev.vars / `wrangler secret put TURNSTILE_SECRET_KEY` — never in a VITE_ var.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_your-site-key

# Optional — Cloudflare Worker (server-side only, use .dev.vars / wrangler secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Cloudflare deployment
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
