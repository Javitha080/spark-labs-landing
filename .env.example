# Spark Labs Landing — example environment (placeholder values only, no secrets)
# Copy to .env for local dev: cp .env.example .env
# Worker-side secrets go in .dev.vars locally or `wrangler secret` when deployed.
# Never commit .env, .env.*, or .dev.vars (all gitignored).

# Required — Supabase (public client keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional — Cloudflare Worker (server-side only, use .dev.vars / wrangler secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — Cloudflare deployment
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
